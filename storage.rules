rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Vehicle photos, RC books, insurance papers and delivery documents.
    // Readable and writable by any signed-in employee; nothing is public.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
