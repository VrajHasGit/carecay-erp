rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Signed in, has a staff profile, and not deactivated. A profile with no
    // `status` field counts as active, matching how AuthContext reads it.
    function active() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().get('status', 'Active') == 'Active';
    }

    function hasRole(roles) {
      return active() && profile().get('role', '') in roles;
    }

    // Staff profiles. Every signed-in employee can read them — the app resolves
    // names, roles and branches across records — but only management edits them.
    match /users/{userId} {
      allow read: if active();
      allow write: if hasRole(['Admin', 'Partner', 'Manager']);
    }

    // Company settings: branches, GST number, letterhead details, theme.
    match /settings/{docId} {
      allow read: if active();
      allow write: if hasRole(['Admin', 'Partner']);
    }

    // Every business record and its media subcollections. Excluding `users` and
    // `settings` here is load-bearing: Firestore grants access when ANY rule
    // matches, so without it this rule would override the stricter ones above.
    match /{col}/{path=**} {
      allow read, write: if !(col in ['users', 'settings']) && active();
    }
  }
}
